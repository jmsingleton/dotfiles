# Ghostty config — see `ghostty +show-config --default --docs`
# Keep ~/Library/Application Support/com.mitchellh.ghostty/config absent on
# macOS — Ghostty layers it over this file (install.sh moves it aside).
font-family = JetBrainsMono Nerd Font
font-size = 14
theme = dark:Rose Pine Moon,light:Rose Pine Dawn
background-opacity = .9
command = tmux new-session -A -s main
copy-on-select = clipboard

# OSC52 clipboard: let tmux/SSH sessions copy to the local clipboard, but prompt
# before anything (including remote hosts) reads it.
clipboard-read = ask
clipboard-write = allow

# Per-machine overrides (gitignored; install.sh writes it on macOS, where
# Ghostty's launch PATH lacks /opt/homebrew/bin)
config-file = ?local
